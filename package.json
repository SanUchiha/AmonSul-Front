{
  "name": "amon-sul",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss}\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync && npx cap open android",
    "cap:assets": "npx capacitor-assets generate --android --ios --iconBackgroundColor \"#121212\" --splashBackgroundColor \"#121212\" --splashBackgroundColorDark \"#121212\" --logoSplashScale 0.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@mdi/font": "^7.4.47",
    "ag-charts-community": "^11.1.1",
    "ag-charts-vue3": "^11.1.1",
    "axios": "^1.6.8",
    "canvas-confetti": "^1.9.3",
    "core-js": "^3.8.3",
    "d3": "^7.9.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "leaflet-control-geocoder": "^3.1.0",
    "leaflet-geosearch": "^4.2.0",
    "material-design-icons-iconfont": "^6.7.0",
    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^2.2.0",
    "sass": "^1.75.0",
    "sass-loader": "^14.2.1",
    "vue": "^3.2.13",
    "vue-leaflet": "^0.1.0",
    "vue-router": "^4.0.3",
    "vuetify": "^3.6.11"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/lodash": "^4.17.16",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
